{
  "name": "voicelet",
  "version": "0.1.0",
  "private": true,
  "description": "Discord Gateway voice-state background worker",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:worker": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "coverage": "vitest run --project unit --project integration --coverage.enabled",
    "build": "tsc",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "fastify": "^5.6.0",
    "pino": "^9.9.4",
    "prom-client": "^15.1.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "volta": {
    "node": "24.20.0"
  }
}
