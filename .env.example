# Secret: required only for a live Discord connection. Keep the real value only in ignored .env.
DISCORD_TOKEN=
# Non-secret local bind and logging settings.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
GATEWAY_MODE=discord
# Non-secret development IDs. Replace placeholders only in local .env; servers omitted here are ignored.
# The destination category is reserved for Voicelet rooms. List any permanent exclusions explicitly.
# inactivityTimeoutMinutes is optional (default 60); reconciliationIntervalMinutes is optional (default 15). Both use whole minutes 1-1440.
TEMPORARY_ROOM_CONFIG='{"<development-server-id>":{"triggerChannelId":"<room-creation-voice-channel-id>","destinationCategoryId":"<temporary-rooms-category-id>","inactivityTimeoutMinutes":5,"reconciliationIntervalMinutes":1,"permanentChannelIds":[]}}'
# Optional: use a Unix-domain socket for process-level local tests.
# SOCKET_PATH=/tmp/voicelet.sock
