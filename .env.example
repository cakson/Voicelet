# Required only for a live Discord connection. Never commit a real token.
DISCORD_TOKEN=
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
GATEWAY_MODE=discord
# JSON map keyed by Discord server ID. Servers omitted here are ignored.
TEMPORARY_ROOM_CONFIG={}
# Optional: use a Unix-domain socket for process-level local tests.
# SOCKET_PATH=/tmp/voicelet.sock
